  "private": true,
  "dependencies": {
    "@coremedia-labs/studio-client.shared.deepl-workflow": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@coremedia/studio-client.build-config": "catalog:",
    "@coremedia/studio-client.eslint-config": "catalog:",
    "@coremedia/studio-client.main.shared-modules": "catalog:",
