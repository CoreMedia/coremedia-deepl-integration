<?xml version="1.0" encoding="UTF-8" ?>
<CMSettings folder="/Settings/Options/Settings/Translation Services" name="DeepL" xmlns:cmexport="http://www.coremedia.com/2012/cmexport">
  <externalRefId></externalRefId>
  <locale>en</locale>
  <master/>
  <settings><Struct xmlns="http://www.coremedia.com/2008/struct" xmlns:xlink="http://www.w3.org/1999/xlink">
    <StructProperty Name="deepl">
      <Struct>
        <!-- Proxy to use for all HTTP requests to DeepL
        <StringProperty Name="proxyUrl">http://proxy.example.com:8080</StringProperty>
         -->
        <StructProperty Name="clientOptions">
          <Struct>
            <IntProperty Name="maxRetries">10</IntProperty>
            <StringProperty Name="timeout">90s</StringProperty>
          </Struct>
        </StructProperty>
        <StructProperty Name="textTranslationOptions">
          <Struct>
            <StringProperty Name="modelType">latency_optimized</StringProperty>
          </Struct>
        </StructProperty>
      </Struct>
    </StructProperty>
  </Struct></settings>
  <identifier></identifier>
</CMSettings>
